{
  "name": "@passayge/gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sandbox gateway: access rules, simulated clock, network log and audit, in front of HAPI FHIR.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "validate:fhir": "tsx scripts/validate-fhir.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@passayge/core": "0.1.0",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/fhir": "^0.0.44",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
