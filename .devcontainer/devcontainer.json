{
  "name": "Passayge",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "memory": "8gb" },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Passayge", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "npm ci",
  "postStartCommand": "docker compose up -d --build",
  "postAttachCommand": "echo 'Passayge starts in two to three minutes on port 8080 (docker compose logs -f gateway to follow).'"
}
